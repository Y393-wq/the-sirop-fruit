<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>The Sirop Fruit</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: linear-gradient(180deg, #fff7df, #ffffff);
      color: #222;
    }

    header {
      background: linear-gradient(135deg, #ff7a00, #ff3d6e);
      color: white;
      text-align: center;
      padding: 45px 20px;
    }

    header h1 {
      font-size: 42px;
      margin: 0 0 10px;
    }

    header p {
      font-size: 20px;
      margin: 0;
    }

    .container {
      max-width: 1000px;
      margin: auto;
      padding: 30px 20px;
    }

    h2 {
      text-align: center;
      font-size: 30px;
      margin-bottom: 25px;
    }

    .flavors {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
    }

    .card {
      background: white;
      border-radius: 20px;
      padding: 25px;
      text-align: center;
      box-shadow: 0 5px 20px rgba(0,0,0,0.12);
    }

    .fruit {
      font-size: 55px;
    }

    .card h3 {
      font-size: 24px;
      margin: 10px 0;
    }

    .prices {
      display: flex;
      justify-content: center;
      gap: 20px;
      flex-wrap: wrap;
      margin-top: 30px;
    }

    .price {
      background: #fff;
      padding: 25px;
      border-radius: 20px;
      min-width: 220px;
      text-align: center;
      box-shadow: 0 5px 20px rgba(0,0,0,0.12);
    }

    .price strong {
      display: block;
      font-size: 35px;
      color: #ff4d5a;
      margin-top: 8px;
    }

    .location {
      text-align: center;
      background: #fff1d6;
      border-radius: 20px;
      padding: 25px;
      margin-top: 35px;
    }

    .location p {
      font-size: 19px;
      margin: 8px;
    }

    .contact {
      text-align: center;
      margin: 35px 0;
    }

    .phone {
      display: inline-block;
      background: #20a84b;
      color: white;
      text-decoration: none;
      padding: 16px 30px;
      border-radius: 50px;
      font-size: 21px;
      font-weight: bold;
    }

    footer {
      background: #222;
      color: white;
      text-align: center;
      padding: 25px;
      margin-top: 40px;
    }
  </style>
</head>

<body>

  <header>
    <h1>🍓 The Sirop Fruit 🍓</h1>
    <p>Des sirops fruités et gourmands !</p>
  </header>

  <main class="container">

    <h2>Nos parfums</h2>

    <div class="flavors">

      <div class="card">
        <div class="fruit">🍑</div>
        <h3>Pêche</h3>
      </div>

      <div class="card">
        <div class="fruit">🥝</div>
        <h3>Banane Kiwi</h3>
      </div>

      <div class="card">
        <div class="fruit">🌿</div>
        <h3>Menthe</h3>
      </div>

      <div class="card">
        <div class="fruit">🍋</div>
        <h3>Citron</h3>
      </div>

    </div>

    <h2 style="margin-top:45px;">Nos prix</h2>

    <div class="prices">

      <div class="price">
        Petite bouteille
        <strong>1 €</strong>
      </div>

      <div class="price">
        Grande bouteille
        <strong>2 €</strong>
      </div>

    </div>

    <div class="location">
      <h2>📍 Où nous trouver ?</h2>
      <p><strong>Mont-de-Marsan</strong></p>
      <p>Devant le collège Cel le Gaucher</p>
    </div>

    <div class="contact">
      <h2>📞 Contact</h2>
      <a class="phone" href="tel:0759202198">
        07 59 20 21 98
      </a>
    </div>

  </main>

  <footer>
    © The Sirop Fruit
  </footer>

</body>
</html>
